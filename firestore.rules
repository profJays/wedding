rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function isBootstrappedAdmin() {
      return isVerifiedUser() && (
        request.auth.uid == 'oFuTnbSimLQSRIaYzMIShk0oQm92'
        || request.auth.token.email == 'joepreserve@gmail.com'
      );
    }
    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Slideshow fields validation (used by safe partial slideshow updates on siteContent/main)
    function isValidSlideshowFields(data) {
      return (!('slideshowAutoplay' in data) || data.slideshowAutoplay is bool)
        && (!('slideshowIntervalMs' in data) || (data.slideshowIntervalMs is int && data.slideshowIntervalMs >= 2000 && data.slideshowIntervalMs <= 30000))
        && (!('slideshowItems' in data) || (data.slideshowItems is list && data.slideshowItems.size() <= 30 && (data.slideshowItems.size() == 0 || data.slideshowItems[0] is map)));
    }

    function isValidSlideshowPartialUpdate(data, prev) {
      return data.diff(prev).affectedKeys().hasOnly([
          'slideshowAutoplay',
          'slideshowIntervalMs',
          'slideshowItems',
          'updatedAt',
          'updatedByUid'
        ])
        && isValidSlideshowFields(data)
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && data.updatedByUid is string
        && data.updatedByUid == request.auth.uid;
    }

    // Website Images Manager safe partial update on siteContent/main
    function isValidWebsiteImagesPartialUpdate(data, prev) {
      return data.diff(prev).affectedKeys().hasOnly([
          'sectionImages',
          'heroImageUrl',
          'puzzleImageUrl',
          'puzzleImageFileId',
          'updatedAt',
          'updatedByUid'
        ])
        && (!('sectionImages' in data) || (data.sectionImages is map && data.sectionImages.size() <= 10))
        && (!('heroImageUrl' in data) || (data.heroImageUrl is string && data.heroImageUrl.size() >= 1 && data.heroImageUrl.size() <= 500))
        && (!('puzzleImageUrl' in data) || (data.puzzleImageUrl is string && data.puzzleImageUrl.size() <= 500))
        && (!('puzzleImageFileId' in data) || (data.puzzleImageFileId is string && data.puzzleImageFileId.size() <= 200))
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && data.updatedByUid is string
        && data.updatedByUid == request.auth.uid;
    }

    // Full SiteContent validation (engineered to stay safely under Firestore's 1,000-expression ceiling)
    function isValidSiteContentCore(data) {
      return data.coupleNames is string && data.coupleNames.size() >= 2 && data.coupleNames.size() <= 100
        && data.brideName is string && data.brideName.size() <= 50
        && data.groomName is string && data.groomName.size() <= 50
        && data.hashtag is string && data.hashtag.size() <= 40
        && data.weddingDateDisplay is string && data.weddingDateDisplay.size() <= 80
        && data.ceremonyTargetISO is string && data.ceremonyTargetISO.size() <= 40
        && data.galleryUnlockISO is string && data.galleryUnlockISO.size() <= 40
        && data.galleryUnlockEpochMs is int && data.galleryUnlockEpochMs > 0
        && data.mainVenue is string && data.mainVenue.size() <= 240
        && data.heroImageUrl is string && data.heroImageUrl.size() >= 1 && data.heroImageUrl.size() <= 500
        && data.contactName is string && data.contactName.size() <= 80
        && data.contactPhone is string && data.contactPhone.size() <= 40
        && data.welcomeHeading is string && data.welcomeHeading.size() <= 160
        && data.welcomeParagraphs is list && data.welcomeParagraphs.size() >= 1 && data.welcomeParagraphs.size() <= 12 && data.welcomeParagraphs[0] is string
        && data.welcomeSignOff is string && data.welcomeSignOff.size() <= 120
        && data.storyHeading is string && data.storyHeading.size() <= 160
        && data.storyParagraphs is list && data.storyParagraphs.size() >= 1 && data.storyParagraphs.size() <= 20 && data.storyParagraphs[0] is string
        && data.coupleQas is list && data.coupleQas.size() <= 30 && (data.coupleQas.size() == 0 || data.coupleQas[0] is map)
        && data.scheduleEvents is list && data.scheduleEvents.size() <= 20 && (data.scheduleEvents.size() == 0 || data.scheduleEvents[0] is map)
        && data.guestFaqs is list && data.guestFaqs.size() <= 30 && (data.guestFaqs.size() == 0 || data.guestFaqs[0] is map)
        && data.footerNote is string && data.footerNote.size() <= 200
        && data.rsvpOpen is bool
        && data.maxGuestsPerRsvp is int && data.maxGuestsPerRsvp >= 1 && data.maxGuestsPerRsvp <= 10
        && data.galleryPublicEnabled is bool;
    }

    function isValidSiteContentExtensions(data) {
      return data.themePrimaryHex is string && data.themePrimaryHex.size() <= 20
        && data.themeAccentHex is string && data.themeAccentHex.size() <= 20
        && data.themeGoldHex is string && data.themeGoldHex.size() <= 20
        && data.puzzleEnabled is bool
        && data.puzzleImageFileId is string && data.puzzleImageFileId.size() <= 200
        && data.puzzleImageUrl is string && data.puzzleImageUrl.size() <= 500
        && data.musicEnabled is bool
        && data.musicTitle is string && data.musicTitle.size() <= 120
        && data.musicArtist is string && data.musicArtist.size() <= 120
        && data.musicAudioFileId is string && data.musicAudioFileId.size() <= 200
        && data.musicAudioUrl is string && data.musicAudioUrl.size() <= 500
        && data.musicAudioFileName is string && data.musicAudioFileName.size() <= 160
        && data.giftingEnabled is bool
        && data.giftingHeading is string && data.giftingHeading.size() <= 120
        && data.giftingIntro is string && data.giftingIntro.size() <= 500
        && data.giftingClosing is string && data.giftingClosing.size() <= 200
        && data.giftingAccountName is string && data.giftingAccountName.size() <= 120
        && data.giftingBankName is string && data.giftingBankName.size() <= 120
        && data.giftingAccountNumber is string && data.giftingAccountNumber.size() <= 60
        && data.sectionTypography is map && data.sectionTypography.size() <= 12
        && data.sectionImages is map && data.sectionImages.size() <= 10
        && data.slideshowAutoplay is bool
        && data.slideshowIntervalMs is int && data.slideshowIntervalMs >= 2000 && data.slideshowIntervalMs <= 30000
        && data.slideshowItems is list && data.slideshowItems.size() <= 30 && (data.slideshowItems.size() == 0 || data.slideshowItems[0] is map)
        && data.updatedAt is timestamp
        && data.updatedByUid is string && data.updatedByUid == request.auth.uid;
    }

    function isValidSiteContent(data) {
      return data.keys().size() == 50
        && data.keys().hasOnly([
          'coupleNames',
          'brideName',
          'groomName',
          'hashtag',
          'weddingDateDisplay',
          'ceremonyTargetISO',
          'galleryUnlockISO',
          'galleryUnlockEpochMs',
          'mainVenue',
          'heroImageUrl',
          'contactName',
          'contactPhone',
          'welcomeHeading',
          'welcomeParagraphs',
          'welcomeSignOff',
          'storyHeading',
          'storyParagraphs',
          'coupleQas',
          'scheduleEvents',
          'guestFaqs',
          'footerNote',
          'rsvpOpen',
          'maxGuestsPerRsvp',
          'galleryPublicEnabled',
          'themePrimaryHex',
          'themeAccentHex',
          'themeGoldHex',
          'puzzleEnabled',
          'puzzleImageFileId',
          'puzzleImageUrl',
          'musicEnabled',
          'musicTitle',
          'musicArtist',
          'musicAudioFileId',
          'musicAudioUrl',
          'musicAudioFileName',
          'giftingEnabled',
          'giftingHeading',
          'giftingIntro',
          'giftingClosing',
          'giftingAccountName',
          'giftingBankName',
          'giftingAccountNumber',
          'sectionTypography',
          'sectionImages',
          'slideshowAutoplay',
          'slideshowIntervalMs',
          'slideshowItems',
          'updatedAt',
          'updatedByUid'
        ])
        && isValidSiteContentCore(data)
        && isValidSiteContentExtensions(data);
    }

    // RSVP validation
    function isValidRsvp(data, maxGuestsAllowed) {
      return data.keys().hasAll([
        'fullName',
        'normalizedName',
        'attending',
        'guestCount',
        'message',
        'submittedAt',
        'updatedAt'
      ]) && data.keys().hasOnly([
        'fullName',
        'normalizedName',
        'attending',
        'guestCount',
        'message',
        'submittedAt',
        'updatedAt'
      ])
      && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
      && data.normalizedName is string && data.normalizedName.size() >= 2 && data.normalizedName.size() <= 100
      && data.attending is bool
      && data.guestCount is int
      && ((data.attending == false && data.guestCount == 0) || (data.attending == true && data.guestCount >= 1 && data.guestCount <= maxGuestsAllowed))
      && data.message is string && data.message.size() <= 1000
      && data.submittedAt is timestamp
      && data.updatedAt is timestamp;
    }

    function getConfiguredMaxGuests() {
      return exists(/databases/$(database)/documents/siteContent/main)
        ? get(/databases/$(database)/documents/siteContent/main).data.maxGuestsPerRsvp
        : 1;
    }

    function isRsvpCurrentlyOpen() {
      return !exists(/databases/$(database)/documents/siteContent/main)
        || get(/databases/$(database)/documents/siteContent/main).data.rsvpOpen == true;
    }

    function getGalleryUnlockEpochMs() {
      return exists(/databases/$(database)/documents/siteContent/main)
        ? get(/databases/$(database)/documents/siteContent/main).data.galleryUnlockEpochMs
        : 1797030000000;
    }

    // Gallery item validation
    function isValidGalleryItem(data) {
      return data.keys().hasAll([
        'title',
        'guestName',
        'mediaType',
        'mimeType',
        'fileUrl',
        'storageProvider',
        'driveFileId',
        'sizeBytes',
        'status',
        'createdAt',
        'updatedAt'
      ]) && data.keys().hasOnly([
        'title',
        'guestName',
        'mediaType',
        'mimeType',
        'fileUrl',
        'storageProvider',
        'driveFileId',
        'sizeBytes',
        'status',
        'createdAt',
        'updatedAt'
      ])
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
      && data.guestName is string && data.guestName.size() <= 80
      && data.mediaType in ['image', 'video', 'audio']
      && data.mimeType is string && data.mimeType.size() >= 3 && data.mimeType.size() <= 80
      && data.fileUrl is string && data.fileUrl.size() >= 1 && data.fileUrl.size() <= 500
      && data.storageProvider in ['google_drive', 'local_server', 'site_asset']
      && data.driveFileId is string && data.driveFileId.size() <= 200
      && data.sizeBytes is int && data.sizeBytes > 0
      && (
        (data.mediaType == 'image' && data.sizeBytes <= 52428800) ||
        (data.mediaType == 'audio' && data.sizeBytes <= 52428800) ||
        (data.mediaType == 'video' && data.sizeBytes <= 104857600)
      )
      && data.status in ['pending', 'approved', 'hidden']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Music Track validation
    function isValidMusicTrack(data) {
      return data.keys().hasAll([
        'title',
        'artist',
        'fileUrl',
        'driveFileId',
        'fileName',
        'storageProvider',
        'enabled',
        'isDefault',
        'order',
        'createdAt',
        'updatedAt',
        'updatedByUid'
      ]) && data.keys().hasOnly([
        'title',
        'artist',
        'fileUrl',
        'driveFileId',
        'fileName',
        'storageProvider',
        'enabled',
        'isDefault',
        'order',
        'createdAt',
        'updatedAt',
        'updatedByUid'
      ])
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
      && data.artist is string && data.artist.size() >= 1 && data.artist.size() <= 120
      && data.fileUrl is string && data.fileUrl.size() >= 1 && data.fileUrl.size() <= 500
      && data.driveFileId is string && data.driveFileId.size() <= 200
      && data.fileName is string && data.fileName.size() <= 160
      && data.storageProvider in ['google_drive', 'local_server', 'site_asset']
      && data.enabled is bool
      && data.isDefault is bool
      && data.order is int && data.order >= 0 && data.order <= 1000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp
      && data.updatedByUid is string && data.updatedByUid == request.auth.uid;
    }

    // Private Guest Song Suggestion validation
    function isValidSongSuggestion(data) {
      return data.keys().hasAll([
        'title',
        'artist',
        'normalizedKey',
        'status',
        'createdAt',
        'updatedAt'
      ]) && data.keys().hasOnly([
        'title',
        'artist',
        'normalizedKey',
        'status',
        'createdAt',
        'updatedAt'
      ])
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
      && data.artist is string && data.artist.size() <= 120
      && data.normalizedKey is string && data.normalizedKey.size() >= 1 && data.normalizedKey.size() <= 200
      && data.status in ['new', 'reviewed', 'added', 'declined']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data, adminUid) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'addedAt', 'addedBy'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'addedAt', 'addedBy'])
        && data.uid is string && data.uid == adminUid && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() <= 100
        && data.addedAt is timestamp
        && data.addedBy is string && data.addedBy == request.auth.uid;
    }

    // 1. Site Content & Settings (Public read for wedding site; strictly admin-only writes with safe partial updates)
    match /siteContent/{contentId} {
      allow get: if isValidId(contentId);
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(contentId)
        && isAdmin()
        && isValidSiteContent(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(contentId)
        && isAdmin()
        && (
          isValidSlideshowPartialUpdate(incoming(), existing())
          || isValidWebsiteImagesPartialUpdate(incoming(), existing())
          || (
            isValidSiteContent(incoming())
            && incoming().updatedAt == request.time
          )
        );
      allow delete: if isAdmin() && isValidId(contentId);
    }

    // 2. RSVP Records (Zero public read/list; write-once create for guests; full management for verified Admin)
    match /rsvps/{rsvpId} {
      allow get: if isAdmin() && isValidId(rsvpId);
      allow list: if isAdmin();
      allow create: if isValidId(rsvpId)
        && isRsvpCurrentlyOpen()
        && isValidRsvp(incoming(), getConfiguredMaxGuests())
        && incoming().submittedAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(rsvpId)
        && isValidRsvp(incoming(), 10)
        && incoming().submittedAt == existing().submittedAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'normalizedName', 'attending', 'guestCount', 'message', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(rsvpId);
    }

    // 3. Gallery Items (Server-time locked before Dec 12 2026 00:00 WAT; guests submit as 'pending')
    match /galleryItems/{itemId} {
      allow get: if isValidId(itemId) && (isAdmin() || existing().status == 'approved');
      allow list: if isAdmin() || resource.data.status == 'approved';
      allow create: if isValidId(itemId)
        && isValidGalleryItem(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            incoming().mediaType in ['image', 'video']
            && request.time.toMillis() >= getGalleryUnlockEpochMs()
            && incoming().status == 'pending'
          )
        );
      allow update: if isAdmin()
        && isValidId(itemId)
        && isValidGalleryItem(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'guestName', 'status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(itemId);
    }

    // 4. Music Library Tracks (Public reads strictly enabled tracks; full management for verified Admin)
    match /musicTracks/{trackId} {
      allow get: if isValidId(trackId) && (isAdmin() || existing().enabled == true);
      allow list: if isAdmin() || resource.data.enabled == true;
      allow create: if isAdmin()
        && isValidId(trackId)
        && isValidMusicTrack(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(trackId)
        && isValidMusicTrack(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'artist',
          'fileUrl',
          'driveFileId',
          'fileName',
          'storageProvider',
          'enabled',
          'isDefault',
          'order',
          'updatedAt',
          'updatedByUid'
        ]);
      allow delete: if isAdmin() && isValidId(trackId);
    }

    // 5. Private Guest Song Suggestions (Zero public read/list; write-once create for guests; admin moderation only)
    match /songSuggestions/{suggestionId} {
      allow get: if isAdmin() && isValidId(suggestionId);
      allow list: if isAdmin();
      allow create: if isValidId(suggestionId)
        && isValidSongSuggestion(incoming())
        && incoming().status == 'new'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(suggestionId)
        && isValidSongSuggestion(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(suggestionId);
    }

    // 6. Admins RBAC registry
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(adminUid)
        && isValidAdminUser(incoming(), adminUid)
        && incoming().addedAt == request.time;
      allow delete: if isBootstrappedAdmin() && isValidId(adminUid);
    }
  }
}
