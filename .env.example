# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Drive Destination Folder ID for Mary & Joseph Wedding Media
# Set this in your runtime secrets to the personal Google Drive folder ID owned by joepreserve@gmail.com
GOOGLE_DRIVE_FOLDER_ID=""

# Optional Google OAuth 2.0 Refresh Token Credentials for unattended public guest uploads
# Admins can connect interactively via OAuth popup in the Admin Dashboard without these;
# provide these three env vars if you also want unauthenticated public guests on Dec 12+ to upload directly without an admin browser session.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REFRESH_TOKEN=""
