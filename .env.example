# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Google Drive Service Account Storage for Wedding Day Guest Gallery Uploads
# When provided in the runtime environment secrets, guest uploads are stored directly in the configured Google Drive folder.
# Leave unset to use the local server media vault (/data/gallery-uploads) until credentials are supplied.
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
