# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Drive Destination Folder ID for Mary & Joseph Wedding Media
# Set this in your runtime secrets to the personal Google Drive folder ID owned by joepreserve@gmail.com
GOOGLE_DRIVE_FOLDER_ID=""

# Google OAuth 2.0 Server Credentials for persistent Google Drive authentication
# Set GOOGLE_OAUTH_REDIRECT_URI to your exact deployed callback URL (e.g. https://<your-domain>/api/drive/oauth/callback)
# and register the exact same URL under Google Cloud Console -> Credentials -> OAuth 2.0 Client -> Authorized redirect URIs.
# If omitted, the server derives it canonically from APP_URL + /api/drive/oauth/callback.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI=""
GOOGLE_OAUTH_REFRESH_TOKEN=""

# Google Analytics 4 (GA4) Integration — Separate from Google Drive OAuth
# Public Measurement ID (e.g. G-XXXXXXXXXX) used by gtag.js on https://mary-joseph.com
GA4_MEASUREMENT_ID=""
# Numeric GA4 Property ID used exclusively on the backend for GA4 Data API & Realtime API reporting
GA4_PROPERTY_ID=""
# Read-only Google Cloud Service Account credentials (Viewer role on GA4 property)
# Provide EITHER GA4_SERVICE_ACCOUNT_JSON (full JSON or base64 JSON) OR email + private key pair below:
GA4_SERVICE_ACCOUNT_JSON=""
GA4_SERVICE_ACCOUNT_EMAIL=""
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=""

