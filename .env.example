# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Drive Destination Folder ID for Mary & Joseph Wedding Media
# Set this in your runtime secrets to the personal Google Drive folder ID owned by joepreserve@gmail.com
GOOGLE_DRIVE_FOLDER_ID=""

# Google OAuth 2.0 Server Credentials for persistent Google Drive authentication
# Set GOOGLE_OAUTH_REDIRECT_URI to your exact deployed callback URL (e.g. https://<your-domain>/api/drive/oauth/callback)
# and register the exact same URL under Google Cloud Console -> Credentials -> OAuth 2.0 Client -> Authorized redirect URIs.
# If omitted, the server derives it canonically from APP_URL + /api/drive/oauth/callback.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI=""
GOOGLE_OAUTH_REFRESH_TOKEN=""
